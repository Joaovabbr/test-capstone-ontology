# Chave da API do OpenRouter
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui

# Caminhos de dados e resultados (opcionais - possuem valores padrão)
DATA_DIR=data
DOCS_DIR=data/docs
ONTOLOGY_FILE=data/capstone_insper.ttl
QUESTIONS_FILE=perguntas.txt
RESULTS_DIR=results
ANSWERS_DIR=results/respostas
METRICS_DIR=results/metricas

# IDs dos modelos no OpenRouter (personalizáveis caso o slug mude na plataforma)
MODEL_GEMINI=google/gemini-3.8-flash
MODEL_CLAUDE=anthropic/claude-opus-5
MODEL_GPT=openai/gpt-5.6-luna
